APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
BACKOFFICE_PREFIX=admin
BOOST_BROWSER_LOGS_WATCHER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SMS / OTP delivery (Arkesel)
# ---------------------------------------------------------------------------
# Without ARKESEL_API_KEY every OTP send fails and sign-in is impossible —
# SmsService logs "Arkesel API key or Sender ID not configured". The key can
# also be set from the admin settings screen, which writes it to the
# `platform_settings` table; that value wins when present, otherwise these
# environment values are used.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=SHAXI

# When true, a failed SMS still leaves a valid OTP in place and writes the code
# to storage/logs/laravel.log, so sign-in works without a working SMS account.
# Defaults to true outside production. NEVER enable in production.
# SMS_OTP_LOG_FALLBACK=false

# App Store review access (disabled unless all values are configured)
APP_REVIEW_ACCESS_ENABLED=false
APP_REVIEW_VENDOR_PHONE=
APP_REVIEW_VENDOR_OTP=
APP_REVIEW_RIDER_PHONE=
APP_REVIEW_RIDER_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
